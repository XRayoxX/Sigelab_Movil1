# Referencia de variables de entorno del servidor. No contiene credenciales.
# Cargar mediante la terminal o la configuración de Azure App Service.
SIGELAB_DB_URL=jdbc:sqlserver://TU-SERVIDOR.database.windows.net:1433;databaseName=TU-BASE;encrypt=true;trustServerCertificate=false;loginTimeout=30
SIGELAB_DB_USER=TU-USUARIO-APLICACION
SIGELAB_DB_PASSWORD=CONFIGURAR-FUERA-DEL-REPOSITORIO
SIGELAB_FACE_URL=https://TU-SERVICIO-FACIAL
SIGELAB_FACE_KEY=CONFIGURAR-FUERA-DEL-REPOSITORIO
PORT=8080
SIGELAB_CORREO_HABILITADO=false
